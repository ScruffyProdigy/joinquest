# Copy to .env for local development: cp .env.example .env
DATABASE_URL=postgres://app:app-pass@127.0.0.1:5432/joinquest?sslmode=disable
# Integration tests use joinquest_test (see ./scripts/db.sh test-migrate). Do not point tests at joinquest.
# TEST_DATABASE_URL=postgres://app:app-pass@127.0.0.1:5432/joinquest_test?sslmode=disable

# Email sign-in (dev: 6-digit code and link are logged to backend stdout)
MAGIC_LINK_BASE_URL=http://localhost:5173/auth/complete?token=
# MAGIC_LINK_PEPPER=          # optional HMAC pepper for hashed magic-link tokens (recommended in prod)
# APP_ENV=production          # enables HTTPS-only game URLs, Secure session cookies, disables GraphQL Playground
SESSION_COOKIE_NAME=lobby_session
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis pub/sub for queue match notifications (required for multi-instance; recommended locally)
REDIS_URL=redis://127.0.0.1:6379/0
# LOBBY_PUBSUB_DEBUG=true   # log queue publish/subscribe + GraphQL subscription delivery

# Game handoff (reference games use api_base_url in DB; GAME_API_BASE_URL is a local dev fallback)
GAME_API_BASE_URL=http://localhost:3001
# LOBBY_HANDOFF_DEBUG=true   # log game provision POSTs
# LOBBY_STALE_MATCH_MINUTES=5   # dev.sh default; omit for 30 in code

# Per-game HMAC service tokens (provision body + GraphQL player lookup). Required in production.
# LOBBY_GAME_TOKEN_PEPPER=
# Dev fallback when pepper is unset (single shared secret, not per-game):
# LOBBY_GAME_SERVICE_TOKEN=

# LOBBY_ISSUER_URL=https://joinquest.cc   # JWT iss + OAuth callback base (preferred)
# LOBBY_PUBLIC_URL=https://joinquest.cc   # browser return URL + fallback issuer

# OAuth (optional — without these, Google/Discord buttons stay hidden)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# Redirect URIs: {LOBBY_ISSUER_URL}/auth/oauth/{google,discord}/callback

# LOBBY_RETURN_URL=https://joinquest.cc/return   # optional override for lobby.returnUrl on provision

# Email (optional — without SMTP_HOST, sign-in codes and links are logged to backend stdout)
# Resend: API key in SMTP_PASSWORD or RESEND_API_KEY. HTTP API is used by default (faster errors than SMTP).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_your_api_key
# SMTP_FROM=noreply@joinquest.cc
# SMTP_FROM_NAME=JoinQuest
# RESEND_USE_SMTP=true

# JWT signing (seat tokens + session cookies). Without JWT_PRIVATE_KEY_PEM the
# backend persists a dev key to backend/.dev-jwt-key.pem so restarts keep the
# same JWKS (required for demo-game-rps LOBBY_JWKS_URL verification).
# Generate for production/k8s: cd backend && go run ./scripts/jwks.go
# JWKS_KID=lobby-dev
# JWT_PRIVATE_KEY_PEM=   # k8s secret key PRIV_PEM maps to this env var
# JWT_DEV_KEY_FILE=      # optional override for dev PEM path

# Admin mutations (registerGame, grantGood, etc.): comma-separated allowlist
LOBBY_ADMIN_EMAILS=ryan.c.kohler@gmail.com

# Spirit animal avatars (optional — without OPENAI_API_KEY the flow uses mock LLM/images)
# Prefer k8s/secrets/lobby-openai.yaml locally (see k8s/secrets/README.md) or set here:
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
