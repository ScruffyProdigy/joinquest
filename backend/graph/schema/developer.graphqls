enum GameVisibility {
  DRAFT
  PRIVATE_TESTING
  PENDING_REVIEW
  PUBLIC
}

enum IntegrationCheckStatus {
  PASS
  FAIL
  SKIPPED
}

type GameIntegrationCheck {
  checkId: String!
  status: IntegrationCheckStatus!
  message: String
  detail: String
  ranAt: Time
}

type CatalogTagOption {
  id: String!
  label: String!
  description: String!
}

"""One allowed value on a catalog axis (genre, difficulty, social mode)."""
type CatalogAxisOption {
  id: String!
  label: String!
  description: String!
}

input RegisterMyGameInput {
  slug: String!
  name: String!
  shortDescription: String!
  apiBaseUrl: String!
  contactEmail: String!
  websiteUrl: String
  communityUrl: String
}

type RegisterMyGamePayload {
  game: Game!
  webhookSecret: String!
  serviceToken: String!
  connected: Boolean!
  connectError: String
}

input UpdateMyGameMetadataInput {
  gameId: ID!
  name: String
  shortDescription: String
  longDescription: String
  howToPlay: String
  """Game genre. One id from `genreTaxonomy`. Empty string clears it."""
  genre: String
  """Difficulty floor. One id from `difficultyTaxonomy`. Empty string clears it."""
  difficulty: String
  contactEmail: String
  websiteUrl: String
  communityUrl: String
  """Hex catalog accent (#rrggbb or #rgb). Empty string resets to the default."""
  accentColor: String
}

input ConnectMyGameInput {
  gameId: ID!
  """Optional new public HTTPS API origin. Omit to retry the current URL."""
  apiBaseUrl: String
}

type ConnectMyGamePayload {
  game: Game!
  connected: Boolean!
  changed: Boolean!
  connectError: String
}

type SyncMyGameManifestPayload {
  game: Game!
  changed: Boolean!
  connectError: String
}

extend type Game {
  visibility: GameVisibility!
  contactEmail: String
  websiteUrl: String
  communityUrl: String
  ownerUserId: ID
  integrationChecks: [GameIntegrationCheck!]!
}

type MyGameCredentials {
  serviceToken: String!
  webhookSecret: String!
}

type DeveloperApiKey {
  id: ID!
  name: String!
  keyPrefix: String!
  createdAt: Time!
  lastUsedAt: Time
}

type CreateDeveloperApiKeyPayload {
  apiKey: DeveloperApiKey!
  secret: String!
}

extend type Query {
  myGames: [Game!]!
  myGame(id: ID!): Game
  myGameCredentials(id: ID!): MyGameCredentials
  myDeveloperApiKeys: [DeveloperApiKey!]!
  developerIntegrationGuide: String!
  developerAgentPlaybook: String!
  developerDiscoveryPrompt: String!
  catalogTagTaxonomy: [CatalogTagOption!]! @deprecated(reason: "The flat tag list was split into axes (JQ-162). Use genreTaxonomy, difficultyTaxonomy and socialModeTaxonomy.")
  """Allowed game genres. Exactly one per game."""
  genreTaxonomy: [CatalogAxisOption!]!
  """Allowed difficulty floors. At most one per game."""
  difficultyTaxonomy: [CatalogAxisOption!]!
  """Allowed social modes. Declared per game mode in the game's manifest."""
  socialModeTaxonomy: [CatalogAxisOption!]!
  pendingGameReviews: [Game!]!
}

extend type Mutation {
  createDeveloperApiKey(name: String): CreateDeveloperApiKeyPayload!
  revokeDeveloperApiKey(id: ID!): Boolean!
  registerMyGame(input: RegisterMyGameInput!): RegisterMyGamePayload!
  """Re-fetch game-modes from the current apiBaseUrl and refresh cached modes/seats."""
  syncMyGameManifest(gameId: ID!): SyncMyGameManifestPayload!
  """Connect or reconnect the game API (optional new apiBaseUrl). Promotes draft → private_testing on success."""
  connectMyGame(input: ConnectMyGameInput!): ConnectMyGamePayload!
  """Rotate the webhook secret. The previous secret stops working immediately."""
  rotateMyGameWebhookSecret(gameId: ID!): MyGameCredentials!
  runMyGameChecks(gameId: ID!): [GameIntegrationCheck!]!
  updateMyGameMetadata(input: UpdateMyGameMetadataInput!): Game!
  requestPublicRelease(gameId: ID!): Game!
  reviewGameRelease(gameId: ID!, approve: Boolean!, reason: String): Game!
}
