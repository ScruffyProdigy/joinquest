scalar Time
scalar UUID
scalar JSON

type Query {
  version: String!
  healthz: String!
  games(limit: Int = 20, offset: Int = 0): [Game!]!
  game(id: ID!): Game
  """Catalog game by URL slug (e.g. word-hunt). Shareable game detail page."""
  gameBySlug(slug: String!): Game
  session(id: ID!): Session
  goods(gameId: ID): [DigitalGood!]!   # list goods globally or by game
  myInventory(gameId: ID): [Entitlement!]!
  myQueueStatus(queueId: ID!): JoinResult!
  # Current catalog play intent: waiting or matched queue (at most one).
  myActiveIntent: ActiveIntent
  # Game servers resolve lobbyUserId → display name (Bearer serviceToken from provision).
  player(id: ID!): PublicPlayer
}

type Subscription {
  queueUpdated(queueId: ID!): QueueUpdate!
}

type Mutation {
  # Games & sessions
  joinQueue(queueId: ID!, queuePath: String, options: [QueueOptionSelectionInput!], party: PartyNodeInput): JoinResult!
  leaveQueue(queueId: ID!): Boolean!
  """
  Report whether one of the caller's open documents is in front of them.

  `documentId` is generated by the client once per document load, not per socket:
  one document opens several graphql-ws clients and they all share a single
  `document.visibilityState`, so visibility is a property of the document.

  A player is "away" when they hold a live socket and none of their documents
  report visible — a different signal from "disconnected", which is the socket
  being gone. A client that never calls this reads as present, so not reporting
  is always safe.
  """
  setDocumentVisibility(documentId: ID!, visible: Boolean!): Boolean!
  """Abandon the current playing intent (matched queue or room table session)."""
  leaveActiveGame: Boolean!
  """
  Mint a fresh, short-lived launch URL back into the match the player is already
  seated in — same seat, same match, new token. Errors once the session is over or
  the player has finished, so it can never re-open a match someone has left.
  """
  rejoinActiveMatch: String!

  # Digital goods (simple entitlement grant)
  grantGood(userId: ID!, goodId: ID!, quantity: Int = 1): Boolean!
  revokeGood(userId: ID!, goodId: ID!, quantity: Int = 1): Boolean!
}
