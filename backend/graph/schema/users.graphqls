type User {
  id: ID!
  email: String
  displayName: String
  avatarUrl: String
  avatarKey: String
  avatarSource: AvatarSource
  # Null until the player picks a name; before that displayName is a placeholder.
  displayNameChosenAt: Time
  createdAt: Time!
  isAdmin: Boolean!
}

# Public player profile for game servers (no email).
type PublicPlayer {
  id: ID!
  displayName: String
  avatarUrl: String
  avatarSource: AvatarSource
}

enum AvatarSource {
  STARTER
  SIGIL
  SPIRIT_ANIMAL
  NONE
}
